{
  "name": "osulloc-redesign",
  "version": "1.0.0",
  "private": true,
  "description": "OSULLOC brand redesign portfolio site",
  "scripts": {
    "test": "node --test --test-reporter=spec tests/smoke.test.cjs",
    "fonts": "node scripts/build-serif-subset.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:local": "node scripts/lighthouse.mjs --local",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint --max-warnings 0 .",
    "lint:css": "stylelint --max-warnings 0 --cache --cache-location node_modules/.cache/stylelintcache \"css/**/*.css\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.61.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0"
  }
}
